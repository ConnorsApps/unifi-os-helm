# UniFi OS Server version pinned by this repo — single source of truth.
# Read by the Makefile, .github/workflows/publish-image.yml, and scripts/*.sh.
# Update with scripts/bump-uos-version.sh (see .claude/skills/upgrade-unifi-os).
# Plain KEY=value only (no quotes, no spaces): parsed by make, bash, and CI.
UOS_VERSION=5.1.40
UOS_RELEASED=
UOS_INSTALLER_URL_AMD64=https://fw-download.ubnt.com/data/unifi-os-server/0e7e-linux-x64-5.1.40-149c6209-9218-4925-86d2-227b6b92f94d.40-x64
UOS_INSTALLER_SHA256_AMD64=
UOS_INSTALLER_URL_ARM64=
UOS_INSTALLER_SHA256_ARM64=
